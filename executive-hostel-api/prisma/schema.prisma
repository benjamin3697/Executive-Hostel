// Executive Hostel Management System — Database Schema
// Matches /docs/executive-hostel-design-docs.md Section 4.
// Phase 1 build focuses on: User, Student, Guardian, AuditLog, RefreshToken.
// Remaining models are included now so later phases (rooms, payments, etc.)
// don't require destructive migrations against real production data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  administrator
  landlady
  chairperson
  public
}

enum RoomStatus {
  vacant
  occupied
  reserved
  under_maintenance
  temporarily_unavailable
}

enum PaymentStatus {
  pending
  verified
  rejected
  clarification_requested
}

enum PaymentMethod {
  bank
  mobile_money
  other
}

enum ApplicationStatus {
  submitted
  under_review
  approved
  rejected
  waitlisted
  cancelled
}

enum StudentStatus {
  applicant
  active
  checked_out
  suspended
}

enum MaintenanceStatus {
  submitted
  in_progress
  resolved
  closed
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum SemesterType {
  regular
  recess
}

// ===================== IDENTITY =====================

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permissions   UserPermission[]
  student       Student?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs     AuditLog[]       @relation("AuditActor")
  notifications Notification[]
  announcements Announcement[]

  @@map("users")
}

model UserPermission {
  userId        String   @map("user_id")
  permissionKey String   @map("permission_key")
  grantedBy     String?  @map("granted_by")
  grantedAt     DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionKey])
  @@map("user_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ===================== PROPERTY STRUCTURE (Phase 3) =====================

model Hostel {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  sections HostelSection[]

  @@map("hostels")
}

model HostelSection {
  id       String @id @default(uuid())
  hostelId String @map("hostel_id")
  name     String

  hostel Hostel @relation(fields: [hostelId], references: [id])
  rooms  Room[]

  @@unique([hostelId, name])
  @@map("hostel_sections")
}

model RoomType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  rooms Room[]
  fees  AccommodationFee[]

  @@map("room_types")
}

model Room {
  id                String     @id @default(uuid())
  sectionId         String     @map("section_id")
  roomNumber        String     @map("room_number")
  roomTypeId        String     @map("room_type_id")
  status            RoomStatus @default(vacant)
  currentStudentId  String?    @unique @map("current_student_id")
  createdAt         DateTime   @default(now()) @map("created_at")

  section         HostelSection @relation(fields: [sectionId], references: [id])
  roomType        RoomType      @relation(fields: [roomTypeId], references: [id])
  currentStudent  Student?      @relation("CurrentRoom", fields: [currentStudentId], references: [id])
  assignments     RoomAssignment[]
  checkIns        CheckIn[]
  checkOuts       CheckOut[]
  maintenance     MaintenanceRequest[]
  payments        Payment[]

  @@unique([sectionId, roomNumber])
  @@map("rooms")
}

// ===================== PEOPLE =====================

model Student {
  id                     String        @id @default(uuid())
  userId                 String        @unique @map("user_id")
  fullName               String        @map("full_name")
  registrationNumber     String        @unique @map("registration_number")
  course                 String?
  yearOfStudy            Int?          @map("year_of_study")
  semesterId             String?       @map("semester_id")
  phone                  String?
  email                  String?
  homeDistrict           String?       @map("home_district")
  emergencyContactName   String?       @map("emergency_contact_name")
  emergencyContactPhone  String?       @map("emergency_contact_phone")
  currentRoomId          String?       @unique @map("current_room_id")
  status                 StudentStatus @default(applicant)
  termsAcceptedAt        DateTime?     @map("terms_accepted_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id])
  semester        Semester?          @relation(fields: [semesterId], references: [id])
  currentRoom     Room?              @relation("CurrentRoom")
  guardians       Guardian[]
  payments        Payment[]
  assignments     RoomAssignment[]
  checkIns        CheckIn[]
  checkOuts       CheckOut[]
  maintenance     MaintenanceRequest[]

  @@map("students")
}

model Guardian {
  id           String  @id @default(uuid())
  studentId    String  @map("student_id")
  name         String?
  relationship String?
  phone        String?
  location     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("guardians")
}

// ===================== ACADEMIC CALENDAR =====================

model AcademicYear {
  id    String @id @default(uuid())
  label String @unique

  semesters Semester[]
  fees      AccommodationFee[]

  @@map("academic_years")
}

model Semester {
  id             String       @id @default(uuid())
  academicYearId String       @map("academic_year_id")
  label          String
  type           SemesterType @default(regular)
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  students     Student[]
  fees         AccommodationFee[]
  payments     Payment[]

  @@map("semesters")
}

// ===================== FEES (Phase 5) =====================

model AccommodationFee {
  id             String    @id @default(uuid())
  roomTypeId     String    @map("room_type_id")
  amount         Decimal   @db.Decimal(12, 2)
  academicYearId String?   @map("academic_year_id")
  semesterId     String?   @map("semester_id")
  effectiveDate  DateTime  @map("effective_date")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  semester     Semester?     @relation(fields: [semesterId], references: [id])
  payments     Payment[]

  @@map("accommodation_fees")
}

// ===================== APPLICATIONS (Phase 9) =====================

model Application {
  id                    String             @id @default(uuid())
  fullName              String             @map("full_name")
  university            String             @default("Soroti University")
  registrationNumber    String?            @map("registration_number")
  course                String?
  yearOfStudy           Int?               @map("year_of_study")
  semesterId            String?            @map("semester_id")
  phone                 String
  email                 String?
  passwordHash          String?            @map("password_hash")
  preferredSectionId    String?            @map("preferred_section_id")
  preferredRoomTypeId   String?            @map("preferred_room_type_id")
  preferredRoomId       String?            @map("preferred_room_id")
  expectedCheckinDate   DateTime?          @map("expected_checkin_date")
  emergencyContact      String?            @map("emergency_contact")
  status                ApplicationStatus  @default(submitted)
  termsAcceptedAt       DateTime?          @map("terms_accepted_at")
  reviewedBy            String?            @map("reviewed_by")
  reviewedAt            DateTime?          @map("reviewed_at")
  createdAt             DateTime           @default(now()) @map("created_at")

  @@map("applications")
}

// ===================== ROOM ASSIGNMENT HISTORY (Phase 4) =====================

model RoomAssignment {
  id         String    @id @default(uuid())
  studentId  String    @map("student_id")
  roomId     String    @map("room_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  releasedAt DateTime? @map("released_at")

  student Student @relation(fields: [studentId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@map("room_assignments")
}

model CheckIn {
  id                 String   @id @default(uuid())
  studentId          String   @map("student_id")
  roomId             String   @map("room_id")
  checkInDate        DateTime @map("check_in_date")
  recordedBy         String?  @map("recorded_by")
  notes              String?
  roomConditionNotes String?  @map("room_condition_notes")

  student Student @relation(fields: [studentId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@map("check_ins")
}

model CheckOut {
  id                  String   @id @default(uuid())
  studentId           String   @map("student_id")
  roomId              String   @map("room_id")
  checkOutDate        DateTime @map("check_out_date")
  reason              String?
  outstandingBalance  Decimal? @db.Decimal(12, 2) @map("outstanding_balance")
  roomConditionNotes  String?  @map("room_condition_notes")
  clearanceStatus     String   @default("pending") @map("clearance_status")
  recordedBy          String?  @map("recorded_by")

  student Student @relation(fields: [studentId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@map("check_outs")
}

// ===================== PAYMENTS (Phase 6 & 7) =====================

model Payment {
  id                   String        @id @default(uuid())
  studentId            String        @map("student_id")
  roomId               String?       @map("room_id")
  academicYearId       String?       @map("academic_year_id")
  semesterId           String?       @map("semester_id")
  accommodationFeeId   String?       @map("accommodation_fee_id")
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  paymentDate          DateTime      @map("payment_date")
  transactionReference String?       @map("transaction_reference")
  payerName            String?       @map("payer_name")
  remarks              String?
  status               PaymentStatus @default(pending)
  previousBalance      Decimal?      @db.Decimal(12, 2) @map("previous_balance")
  remainingBalance     Decimal?      @db.Decimal(12, 2) @map("remaining_balance")
  submittedAt          DateTime      @default(now()) @map("submitted_at")
  verifiedBy           String?       @map("verified_by")
  verifiedAt           DateTime?     @map("verified_at")
  rejectionReason      String?       @map("rejection_reason")
  adminRemarks         String?       @map("admin_remarks")

  student          Student           @relation(fields: [studentId], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  semester         Semester?         @relation(fields: [semesterId], references: [id])
  accommodationFee AccommodationFee? @relation(fields: [accommodationFeeId], references: [id])
  evidence         PaymentEvidence[]
  corrections      PaymentCorrection[]

  @@map("payments")
}

model PaymentEvidence {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_evidence")
}

model PaymentCorrection {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  correctedBy     String   @map("corrected_by")
  reason          String
  previousAmount  Decimal? @db.Decimal(12, 2) @map("previous_amount")
  newAmount       Decimal? @db.Decimal(12, 2) @map("new_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_corrections")
}

// ===================== MAINTENANCE (Phase 11) =====================

model MaintenanceRequest {
  id          String             @id @default(uuid())
  studentId   String             @map("student_id")
  roomId      String?            @map("room_id")
  category    String
  description String
  imageUrl    String?            @map("image_url")
  status      MaintenanceStatus  @default(submitted)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])
  room    Room?   @relation(fields: [roomId], references: [id])

  @@map("maintenance_requests")
}

// ===================== ANNOUNCEMENTS & NOTIFICATIONS (Phase 10) =====================

model Announcement {
  id             String               @id @default(uuid())
  authorId       String               @map("author_id")
  title          String
  message        String
  priority       AnnouncementPriority @default(normal)
  audienceType   String               @default("all") @map("audience_type")
  audienceRef    String?              @map("audience_ref")
  attachmentUrl  String?              @map("attachment_url")
  publishedAt    DateTime             @default(now()) @map("published_at")

  author User @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String   @map("recipient_id")
  type        String
  payload     Json?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientId], references: [id])

  @@map("notifications")
}

// ===================== CONTENT / CONFIG (Phase 13) =====================

model HostelGuideline {
  id        String   @id @default(uuid())
  category  String
  content   String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hostel_guidelines")
}

model Contact {
  id     String  @id @default(uuid())
  label  String
  phone  String?
  email  String?
  notes  String?

  @@map("contacts")
}

model SystemSetting {
  key       String   @id
  value     String?
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ===================== AUDIT (used from Phase 1 onward) =====================

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}
