# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://user:password@host:5432/database"

# Generate strong random secrets, e.g. openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-random-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

PORT=4000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173"

# Email delivery
RESEND_API_KEY=""
EMAIL_FROM="Executive Hostel <noreply@example.com>"
APP_URL="http://localhost:5173"

# SMS delivery
AT_API_KEY=""
AT_USERNAME="sandbox"

# Private S3-compatible storage for payment evidence
S3_ENDPOINT="https://s3.example.com"
S3_REGION="region"
S3_BUCKET="executive-hostel-evidence"
S3_ACCESS_KEY_ID="replace-with-storage-access-key"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret"
S3_MAX_UPLOAD_BYTES=8388608
