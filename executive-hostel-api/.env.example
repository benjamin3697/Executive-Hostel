# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://postgres.mavkjdihigbewqtshclr:oDZEvcAQWyfDaxCU@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="b05f42e9ad09795378d021f7d13c5b21cda24683023ce1024b0b435f60f41ec5"

JWT_REFRESH_SECRET="c8e1204fe778daee6b800a93472dff26966733e73af28e1e057f411d5e3b8e7d"


# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

PORT=4000
NODE_ENV="development"

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS="http://localhost:5173"

# --- Email delivery (password resets, application approvals) ---
# Using Resend's free tier (100 emails/day, no card required) via a simple
# HTTPS API call - no SDK needed. Sign up at resend.com, verify a sending
# domain (or use their shared onboarding domain for testing), and create an
# API key.
# If RESEND_API_KEY is left blank, emails are logged to the console instead
# of sent - useful for local dev, NOT acceptable for production.
RESEND_API_KEY=""
EMAIL_FROM="Executive Hostel <noreply@yourdomain.com>"
# Base URL of the deployed frontend, used to build links inside emails
# (e.g. the password reset link). No trailing slash.
APP_URL="http://localhost:5173"

# --- SMS delivery (phone-only accounts - password resets, application
# approvals for applicants without an email on file) ---
# Using Africa's Talking (africastalking.com) - built for Ugandan/East
# African carriers, with a free sandbox environment for testing before you
# need a paid account. Sign up, create an app, get your API key.
# Leave AT_API_KEY blank to log SMS to the console instead of sending -
# same fallback behavior as RESEND_API_KEY above.
AT_API_KEY=""
AT_USERNAME="sandbox"

# --- File storage (payment evidence, maintenance photos) ---
# Using Backblaze B2's free tier (10GB storage + 1GB/day download, free) via
# its S3-compatible API. To set up:
#   1. Sign up at backblaze.com/b2 (no card required for the free tier)
#   2. Create a bucket, set it to PRIVATE (not public) - critical, this is
#      where payment evidence lives, and it must never be publicly readable
#   3. Create an "Application Key" scoped to just that bucket
#   4. Your endpoint is shown on the bucket page, e.g.
#      https://s3.us-west-004.backblazeb2.com  (region = the "004" part: us-west-004)
S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
S3_REGION="us-west-004"
S3_BUCKET="executive-hostel-evidence"
S3_ACCESS_KEY_ID="replace-with-b2-application-key-id"
S3_SECRET_ACCESS_KEY="replace-with-b2-application-key"
# Max upload size in bytes, enforced by the bucket itself via presigned POST
# conditions (docs Section 13: "Apply appropriate file-size restrictions")
S3_MAX_UPLOAD_BYTES=8388608
