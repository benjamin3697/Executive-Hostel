# Frontend Environment Variables
# For production builds, set VITE_API_BASE_URL to your deployed API's URL.
# Example: https://executive-hostel-api.onrender.com
# This tells the frontend where to send API requests.
# 
# In development (npm run dev), Vite's proxy (vite.config.ts) forwards 
# /api to localhost:4000, so this can remain empty locally.

VITE_API_BASE_URL=https://your-api-url.onrender.com

# Supabase Configuration
# Get these values from your Supabase project settings (Project Settings → API)
# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://your-project.supabase.co)
# VITE_SUPABASE_ANON_KEY: Your Supabase anonymous key (public key, safe to expose)
